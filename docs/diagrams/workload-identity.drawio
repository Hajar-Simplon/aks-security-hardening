 id="projectlabel" value="1  Short-lived token" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=17;fontColor=#16324f;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="275" y="495" width="210" height="30" as="geometry" /></mxCell><mxCell id="projectnote" value="AKS signs and projects the token into the Pod." style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=16;fontColor=#16324f;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="55" y="661" width="420" height="30" as="geometry" /></mxCell><mxCell id="entra" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2064%2064%22%3E%3Cpath%20d%3D%22M32%203%2061%2043%2042%2058%203%2043Z%22%20fill%3D%22%230078d4%22%2F%3E%3Cpath%20d%3D%22m32%203%2010%2055-21-18Z%22%20fill%3D%22%2350e6ff%22%2F%3E%3Cpath%20d%3D%22m21%2040%2021%2018L3%2043Z%22%20fill%3D%22%232255aa%22%2F%3E%3C%2Fsvg%3E;" vertex="1" parent="1"><mxGeometry x="790" y="305" width="100" height="100" as="geometry" /></mxCell><mxCell id="entratxt" value="Microsoft Entra ID&#10;Token exchange" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=21;fontColor=#16324f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="715" y="422" width="250" height="60" as="geometry" /></mxCell><mxCell id="exchange" style="endArrow=block;strokeWidth=2;strokeColor=#345a7c;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="330" as="sourcePoint" /><mxPoint x="780" y="330" as="targetPoint" /></mxGeometry></mxCell><mxCell id="exchangelabel" value="2  Send ServiceAccount token" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=17;fontColor=#16324f;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="440" y="286" width="320" height="30" as="geometry" /></mxCell><mxCell id="return" style="endArrow=block;strokeWidth=2;strokeColor=#345a7c;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780" y="390" as="sourcePoint" /><mxPoint x="330" y="390" as="targetPoint" /></mxGeometry></mxCell><mxCell id="returnlabel" value="4  Return Azure access token" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=17;fontColor=#16324f;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="440" y="398" width="320" height="30" as="geometry" /></mxCell><mxCell id="trustbox" value="" style="rounded=1;arcSize=10;fillColor=#f6f2fc;strokeColor=#c5d8e9;" vertex="1" parent="1"><mxGeometry x="650" y="140" width="400" height="135" as="geometry" /></mxCell><mxCell id="trusticon" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2064%2064%22%3E%3Ccircle%20cx%3D%2221%22%20cy%3D%2223%22%20r%3D%2214%22%20fill%3D%22none%22%20stroke%3D%22%238661c5%22%20stroke-width%3D%227%22%2F%3E%3Cpath%20d%3D%22m31%2033%2024%2024m-8-8%208-8m-16%200%208-8%22%20stroke%3D%22%238661c5%22%20stroke-width%3D%227%22%2F%3E%3C%2Fsvg%3E;" vertex="1" parent="1"><mxGeometry x="670" y="172" width="60" height="60" as="geometry" /></mxCell><mxCell id="trusttext" value="3  Verify federation trust&#10;Signature + issuer + subject + audience" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=16;fontColor=#16324f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="735" y="161" width="300" height="60" as="geometry" /></mxCell><mxCell id="trustline" style="endArrow=block;strokeWidth=2;strokeColor=#345a7c;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="840" y="305" as="sourcePoint" /><mxPoint x="840" y="276" as="targetPoint" /></mxGeometry></mxCell><mxCell id="managed" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2064%2064%22%3E%3Ccircle%20cx%3D%2226%22%20cy%3D%2219%22%20r%3D%2212%2