<mxfile host="app.diagrams.net"><diagram name="Workload Identity" id="architecture"><mxGraphModel page="1" pageWidth="1440" pageHeight="900"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="AKS → Azure: authentication without an access key" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=30;fontColor=#16324f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="25" width="1240" height="30" as="geometry" /></mxCell><mxCell id="subtitle" value="The application exchanges a Kubernetes token for an Azure access token." style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=19;fontColor=#16324f;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="100" y="75" width="1240" height="30" as="geometry" /></mxCell><mxCell id="aks" value="" style="rounded=1;arcSize=10;fillColor=#f1f7fe;strokeColor=#c5d8e9;" vertex="1" parent="1"><mxGeometry x="35" y="140" width="460" height="585" as="geometry" /></mxCell><mxCell id="aksicon" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2064%2064%22%3E%3Cpath%20d%3D%22m32%202%2025%2012%206%2027-18%2021H19L1%2041%207%2014Z%22%20fill%3D%22%23326ce5%22%2F%3E%3Ccircle%20cx%3D%2232%22%20cy%3D%2232%22%20r%3D%2215%22%20fill%3D%22none%22%20stroke%3D%22white%22%20stroke-width%3D%223%22%2F%3E%3Cpath%20d%3D%22M32%2010v44M11%2025l42%2014M17%2049l30-34M11%2039l42-14M17%2015l30%2034%22%20stroke%3D%22white%22%20stroke-width%3D%222%22%2F%3E%3C%2Fsvg%3E;" vertex="1" parent="1"><mxGeometry x="65" y="160" width="45" height="45" as="geometry" /></mxCell><mxCell id="akstitle" value="AKS cluster" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=23;fontColor=#16324f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="125" y="168" width="230" height="30" as="geometry" /></mxCell><mxCell id="pod" value="" style="shape=image;imageAspect=0;aspect=fixed;image=