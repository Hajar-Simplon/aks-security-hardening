rrow=block;strokeWidth=2;strokeColor=#345a7c;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="460" as="sourcePoint" /><mxPoint x="1110" y="594" as="targetPoint" /><Array as="points"><mxPoint x="550" y="460" /><mxPoint x="550" y="594" /></Array></mxGeometry></mxCell><mxCell id="apicalllabel" value="5  Call Azure with the access token" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=17;fontColor=#16324f;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="635" y="552" width="410" height="30" as="geometry" /></mxCell><mxCell id="rbac" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2064%2064%22%3E%3Cpath%20d%3D%22m32%203%2025%2010v19c0%2019-25%2030-25%2030S7%2051%207%2032V13Z%22%20fill%3D%22%23159570%22%2F%3E%3Cpath%20d%3D%22m19%2031%209%2010%2018-22%22%20fill%3D%22none%22%20stroke%3D%22white%22%20stroke-width%3D%225%22%2F%3E%3C%2Fsvg%3E;" vertex="1" parent="1"><mxGeometry x="1129" y="731" width="65" height="65" as="geometry" /></mxCell><mxCell id="rbactxt" value="6  Check Azure RBAC&#10;Allow only granted operations" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=18;fontColor=#16324f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="885" y="736" width="250" height="60" as="geometry" /></mxCell><mxCell id="rolelink" style="endArrow=block;strokeWidth=2;strokeColor=#345a7c;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1190" y="313" as="sourcePoint" /><mxPoint x="1210" y="757" as="targetPoint" /><Array as="points"><mxPoint x="1330" y="313" /><mxPoint x="1330" y="757" /></Array></mxGeometry></mxCell><mxCell id="rolelinklabel" value="Assigned roles" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=17;fontColor=#16324f;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1190" y="440" width="205" height="30" as="geometry" /></mxCell><mxCell id="check" style="endArrow=block;strokeWidth=2;strokeColor=#345a7c;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1163" y="730" as="sourcePoint" /><mxPoint x="1163" y="700" as="targetPoint" /></mxGeometry></mxCell><mxCell id="legend" value="Authentication = who the workload is     •     Authorization = what it may do" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=20;fontColor=#16324f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="823" width="1240" height="30" as="geometry" /></mxCell><mxCell id="example" value="Illustrative ServiceAccount and application identity. Cluster prerequisites: OIDC and Workload Identity enabled." style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=15;fontColor=#16324f;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="100" y="865" width="1240" height="30" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>